<!--
    Weather tool (service-level proxy) policy.
    This service-level API forwards requests to the Weather API that is managed
    inside the Weather workspace and served on the API Management default gateway.
    The {backend-url} placeholder is replaced at deployment time in main.bicep with
    the workspace API base URL (e.g. https://<service>.azure-api.net/weather).
-->
<policies>
    <inbound>
        <base />
        <trace source="Weather tool" severity="information">
            <message>Weather tool invoked (proxying to the Weather workspace API)</message>
            <metadata name="agent-id" value="@(context.Request.Headers.GetValueOrDefault("agent-id", "n/a"))" />
        </trace>
        <set-backend-service base-url="{backend-url}" />
        <set-header name="api-key" exists-action="delete" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
